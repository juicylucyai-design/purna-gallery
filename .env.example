# PostgreSQL connection. On Railway this is provided by the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Optional
PORT=3000
DATABASE_POOL_MAX=5

# Email via Resend (resend.com). Every email is optional: with RESEND_API_KEY blank, signups and enquiries are
# still saved and nothing is sent. See server/src/modules/notification to swap Resend for another provider.
#
# EMAIL_FROM: Resend's shared onboarding@resend.dev sender can only deliver to your own Resend account address.
# To send welcome emails to subscribers, verify purnagallery.com in Resend and use e.g.
#   EMAIL_FROM=Purna Gallery <hello@purnagallery.com>
RESEND_API_KEY=
EMAIL_FROM=
# Where new designer enquiries are sent (comma-separated for more than one address).
TEAM_EMAIL_TO=sanjana@purnagallery.com
